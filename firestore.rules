rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(v) {
      return v is string && v.size() > 0 && v.size() <= 50;
    }

    // Private user record: only its owner may read it. It is created exactly
    // once at registration with the five required fields; updates and
    // deletes are denied so registrationDateTime can never be reset.
    // `role` is descriptive only and is never used to grant access.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'firstName', 'lastName', 'role', 'registrationDateTime'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.firstName)
        && validName(request.resource.data.lastName)
        && request.resource.data.role in ['student', 'instructor', 'other']
        && request.resource.data.registrationDateTime == request.time;
      allow update, delete: if false;

      // Notification prefs (Opt-In Notifier spice): owner only.
      match /prefs/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    function validText(v) {
      return v is string && v.size() > 0 && v.size() <= 500;
    }

    // Public board: any signed-in user may read every message, but only the
    // author may create (as themselves), update, or delete their own.
    match /messages/{msgId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['text', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && validText(request.resource.data.text)
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 101
        && request.resource.data.createdAt == request.time;

      // Owner may change only text and editedAt — never authorUid,
      // authorName, or createdAt.
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['text', 'editedAt'])
        && validText(request.resource.data.text)
        && request.resource.data.editedAt == request.time;

      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
